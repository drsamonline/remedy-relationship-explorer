{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remedy Relationship Explorer",
  "version": "1.0.0",
  "identifier": "in.drsamonline.remedygraph",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      { "title": "Remedy Relationship Explorer", "width": 1280, "height": 860, "minWidth": 420, "minHeight": 560 }
    ],
